# Copy to .env in the project root (gitignored). Never commit real values.
#
#   cp .env.example .env

ISO_PATH=/path/to/ubuntu-25.10-live-server-amd64.iso
UBUNTU_PASSWORD=

# PXE server SSH target
PXE_USER=pi
PXE_HOST=pxe.local
PXE_IP=192.168.0.254

# Optional path overrides
# PXE_BASE=/home/pi/pxe
# PXE_TFTP_ROOT=/home/pi/pxe/tftp
# PXE_HTTP_ROOT=/home/pi/pxe/http
