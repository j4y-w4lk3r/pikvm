{
  "description": "KVMD API port 1 = UI Port 2. Templates under images/p2-test/.",
  "pikvm_port": 1,
  "stream_keeper": true,
  "warmup": 5,
  "steps": [
    {
      "wait_image_pikvm": "images/fin/0.jpg",
      "timeout": 600,
      "interval": 1.0,
      "threshold": 0.61
    },
    { "type": "alarm" },
    { "key": "enter" },
    {
      "wait_image_pikvm": "images/fin/1.jpg",
      "timeout": 600,
      "interval": 1.0,
      "threshold": 0.61
    },
    { "type": "alarm" },
    { "key": "enter" }
  ]
}
